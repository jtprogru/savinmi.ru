---
const year = new Date().getFullYear();

const socials = [
  { href: "https://t.me/jtprogru_channel", label: "Telegram канал", icon: "telegram" },
  { href: "https://github.com/jtprogru", label: "GitHub", icon: "github" },
  { href: "https://twitter.com/jtprogru", label: "X / Twitter", icon: "x" },
  { href: "https://linkedin.com/in/jtprogru", label: "LinkedIn", icon: "linkedin" },
  { href: "https://mas.to/@jtprogru", label: "Mastodon", icon: "mastodon", me: true },
  { href: "https://leetcode.com/jtprogru/", label: "LeetCode", icon: "leetcode" },
  { href: "https://unsplash.com/@jtprogru", label: "Unsplash", icon: "unsplash" },
  { href: "https://jtprog.ru", label: "Блог jtprog.ru (RSS)", icon: "rss" },
  { href: "https://sponsr.ru/jtprogru_channel/", label: "Поддержать", icon: "ruble" },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav class="social" aria-label="Социальные сети">
      {socials.map((s) => (
        <a
          href={s.href}
          aria-label={s.label}
          title={s.label}
          rel={s.me ? "me noopener noreferrer" : "noopener noreferrer"}
          target="_blank"
        >
          {s.icon === "telegram" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
          )}
          {s.icon === "github" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.17-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17.91-.25 1.89-.38 2.86-.39.97.01 1.95.14 2.86.39 2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.73.8 1.17 1.82 1.17 3.07 0 4.4-2.69 5.37-5.25 5.65.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.38 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
          )}
          {s.icon === "x" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.65l-5.21-6.81-5.96 6.81H1.696l7.73-8.835L1.254 2.25h6.79l4.71 6.23 5.49-6.23zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"/></svg>
          )}
          {s.icon === "linkedin" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.74v20.52C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z"/></svg>
          )}
          {s.icon === "mastodon" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.58 6.18c-.33-2.46-2.5-4.4-5.07-4.78-.43-.06-2.07-.31-5.89-.31h-.03c-3.81 0-4.63.25-5.07.31C2.99 1.77.7 3.51.15 5.99c-.27 1.22-.3 2.57-.25 3.81.07 1.78.08 3.55.25 5.32.11 1.18.32 2.34.61 3.49.55 2.12 2.66 3.88 4.71 4.61 2.2.75 4.55.88 6.81.36.25-.06.49-.13.74-.21.55-.18 1.19-.37 1.66-.71.01 0 .02-.01.02-.02v-1.71c0-.02 0-.03-.01-.04 0-.01-.01-.02-.02-.02-.01-.01-.02-.01-.03-.01h-.04c-1.42.34-2.88.51-4.34.51-2.51 0-3.19-1.19-3.38-1.69-.16-.42-.26-.86-.3-1.31 0-.02 0-.03.01-.05.01-.01.02-.03.03-.03.01-.01.03-.02.04-.02h.05c1.4.34 2.83.51 4.27.51.35 0 .69 0 1.04-.01 1.45-.04 2.97-.11 4.39-.39.04-.01.07-.01.11-.02 2.25-.43 4.39-1.79 4.61-5.22.01-.13.04-1.41.04-1.55.01-.48.16-3.39-.02-5.18zM17.69 13.5h-2.07V8.48c0-1.05-.44-1.59-1.33-1.59-.98 0-1.47.63-1.47 1.89v2.74h-2.06V8.78c0-1.26-.49-1.89-1.47-1.89-.89 0-1.33.54-1.33 1.59v5.02H5.89v-5.17c0-1.05.27-1.89.81-2.51.55-.62 1.28-.93 2.18-.93 1.03 0 1.83.39 2.39 1.18l.51.86.51-.86c.55-.79 1.35-1.18 2.39-1.18.9 0 1.62.31 2.18.93.54.62.81 1.46.81 2.51v5.17z"/></svg>
          )}
          {s.icon === "leetcode" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.103 17.965l-2.296 2.295c-.498.498-1.165.772-1.879.772s-1.381-.274-1.879-.772l-4.81-4.811c-.498-.498-.772-1.165-.772-1.879s.274-1.381.772-1.879l4.81-4.811c.498-.498 1.165-.772 1.879-.772s1.381.274 1.879.772l2.296 2.295a1.374 1.374 0 0 0 1.943-1.943l-2.296-2.295A4.103 4.103 0 0 0 11.928 3.4a4.103 4.103 0 0 0-2.92 1.218l-4.81 4.81A4.107 4.107 0 0 0 3 12.348c0 1.103.43 2.14 1.21 2.921l4.81 4.81a4.103 4.103 0 0 0 2.92 1.219 4.103 4.103 0 0 0 2.92-1.219l2.296-2.295a1.374 1.374 0 0 0-1.943-1.943zm3.508-3.594h-9.504a1.374 1.374 0 0 0 0 2.748h9.504a1.374 1.374 0 0 0 0-2.748z"/></svg>
          )}
          {s.icon === "unsplash" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 6.75V0h9v6.75h-9zm9 3.75H24V24H0V10.5h7.5v6.75h9V10.5z"/></svg>
          )}
          {s.icon === "rss" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A19.56 19.56 0 0 1 19.56 20h-3.1A16.46 16.46 0 0 0 4 7.54V4.44zm0 5.66a13.9 13.9 0 0 1 9.9 9.9h-3.1A10.8 10.8 0 0 0 4 13.2V10.1z"/></svg>
          )}
          {s.icon === "ruble" && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 3h6c3.5 0 6 2.2 6 5.5S16.5 14 13 14H9v2h6v2H9v3H7v-3H5v-2h2v-2H5v-2h2V3zm2 2v9h4c2.4 0 4-1.5 4-3.5S15.4 5 13 5H9z"/></svg>
          )}
        </a>
      ))}
    </nav>
    <div class="copyright">© 1990–{year} Михаил Савин · <a href="https://github.com/jtprogru/savinmi.ru">исходники</a></div>
  </div>
</footer>
