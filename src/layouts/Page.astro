---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { NAME } from "../data/person";
import "@fontsource/pt-sans/400.css";
import "@fontsource/pt-sans/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

interface PageMeta {
  title?: string;
  description?: string;
  pageType?: "profile" | "page";
  noindex?: boolean;
}

interface Props extends PageMeta {
  frontmatter?: PageMeta;
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? NAME;
const description =
  Astro.props.description ??
  frontmatter?.description ??
  "Резюме Михаила Савина — Lead SRE, Head of Reliability. Опыт, навыки, проекты.";
const pageType = Astro.props.pageType ?? frontmatter?.pageType ?? "page";
const noindex = Astro.props.noindex ?? frontmatter?.noindex ?? false;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/img/fav-light.svg" />

    <Seo {title} {description} {pageType} {noindex} />

    <script is:inline>
      (function () {
        const root = document.documentElement;
        let mode = "system";
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") mode = stored;
        } catch (_) {}
        root.dataset.themeMode = mode;

        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          if (root.dataset.themeMode === "system") {
            root.dataset.theme = mq.matches ? "dark" : "light";
          } else {
            root.dataset.theme = root.dataset.themeMode;
          }
        };
        apply();
        mq.addEventListener("change", apply);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) return;
        }
        k = e.createElement(t); a = e.getElementsByTagName(t)[0];
        k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

      ym(98611647, "init", {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
      });
    </script>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/98611647" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>
  </body>
</html>
